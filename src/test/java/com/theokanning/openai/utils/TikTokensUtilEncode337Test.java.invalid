            assertEquals(0, (int) result.size(), "Returned list should be empty on repeated calls");
        }
    }
    @Test
    @Tag("invalid")
    public void testEncodeWithRegistryReturningNullEncodingHandlesGracefully() {
        // COMMENT: TikTokensUtil.encode calls getEncoding, which will return null here.
        // Method will then throw NullPointerException at 'enc.encode(text)'.
        // Consider handling null registry lookups more gracefully in business logic.
        String text = "test";
        EncodingType encodingType = validEncodingType;
        when(mockRegistry.getEncoding((EncodingType) encodingType)).thenReturn(null);
        try {
            TikTokensUtil.encode(encodingType, text);
        } catch (Exception e) {
            assertTrue(e instanceof NullPointerException, "Should throw NullPointerException when registry returns null encoding");
        }
    }
    @Test
    @Tag("boundary")
    public void testEncodeWithVariousUnicodeSpaceCharactersReturnsEmptyList() {
        String text = "\u00A0\u2000\u3000"; // Non-breaking space, En quad, Ideographic space
        EncodingType encodingType = validEncodingType;
        List<Integer> result = TikTokensUtil.encode(encodingType, text);
        assertNotNull(result, "Returned list should not be null");
        assertEquals(0, (int) result.size(), "Unicode space chars should not be tokenized");
    }
}