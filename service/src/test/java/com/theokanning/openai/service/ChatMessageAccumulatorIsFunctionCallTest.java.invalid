package com.theokanning.openai.service;import com.theokanning.openai.completion.chat.ChatFunctionCall;
import com.theokanning.openai.completion.chat.ChatMessage;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

public class ChatMessageAccumulatorIsFunctionCallTest {
    @Test
    @Tag("valid")
    public void accumulatedMessageContainsValidFunctionCall() {
        ChatFunctionCall functionCall = mock(ChatFunctionCall.class);
        when(functionCall.getName()).thenReturn("validFunctionName");
        ChatMessage accumulatedMessage = mock(ChatMessage.class);
        when(accumulatedMessage.getFunctionCall()).thenReturn(functionCall);
        ChatMessageAccumulator accumulator = new ChatMessageAccumulator(null, accumulatedMessage);
        assertTrue(accumulator.isFunctionCall());
    }
    @Test
    @Tag("invalid")
    public void accumulatedMessageContainsFunctionCallWithNullName() {
        ChatFunctionCall functionCall = mock(ChatFunctionCall.class);
        when(functionCall.getName()).thenReturn(null);
        ChatMessage accumulatedMessage = mock(ChatMessage.class);
        when(accumulatedMessage.getFunctionCall()).thenReturn(functionCall);
        ChatMessageAccumulator accumulator = new ChatMessageAccumulator(null, accumulatedMessage);
        assertFalse(accumulator.isFunctionCall());
    }
    @Test
    @Tag("invalid")
    public void accumulatedMessageDoesNotContainFunctionCall() {
        ChatMessage accumulatedMessage = mock(ChatMessage.class);
        when(accumulatedMessage.getFunctionCall()).thenReturn(null);
        ChatMessageAccumulator accumulator = new ChatMessageAccumulator(null, accumulatedMessage);
        assertFalse(accumulator.isFunctionCall());
