    void executorServiceUsedForStreamingOperations() throws Exception {
        CompletionChunk chunk = new CompletionChunk();
        chunk.setId("exec-test");
        String jsonChunk = com.theokanning.openai.service.OpenAiService.defaultObjectMapper().writeValueAsString(chunk);
        ResponseBody responseBody = ResponseBody.create(okhttp3.MediaType.get("application/json"), jsonChunk);
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        when(mockCall.execute()).thenReturn(retrofit2.Response.success(responseBody));
        CompletionRequest request = new CompletionRequest();
        AtomicBoolean executorUsed = new AtomicBoolean(false);
        doAnswer(invocation -> {
            executorUsed.set(true);
            return null;
        }).when(mockExecutorService).execute(any(Runnable.class));
        openAiService.streamCompletion(request).blockingForEach(c -> {});
        assertTrue(executorUsed.get(), "ExecutorService was not used for streaming");
    }
    @Test
    @Tag("invalid")
    void handlesUnexpectedResponseDataTypesGracefully() throws Exception {
        ResponseBody badTypeBody = ResponseBody.create(okhttp3.MediaType.get("application/json"), "\"not-a-chunk\"");
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        when(mockCall.execute()).thenReturn(retrofit2.Response.success(badTypeBody));
        CompletionRequest request = new CompletionRequest();
        List<Throwable> errors = new ArrayList<>();
        openAiService.streamCompletion(request).blockingSubscribe(c -> {}, errors::add);
        assertFalse(errors.isEmpty());
    }
