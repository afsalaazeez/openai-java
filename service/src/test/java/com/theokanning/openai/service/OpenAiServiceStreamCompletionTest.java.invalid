        List<CompletionChunk> receivedB = new ArrayList<>();
        openAiService.streamCompletion(reqA).blockingForEach(receivedA::add);
        openAiService.streamCompletion(reqB).blockingForEach(receivedB::add);
        assertEquals("streamA", receivedA.get(0).getId());
        assertEquals("streamB", receivedB.get(0).getId());
    }
