    @Test
    @Tag("boundary")
    void handlesExecutorShutdownMidStream() throws Exception {
        CompletionChunk chunk = new CompletionChunk();
        chunk.setId("job");
        String jsonChunk = com.theokanning.openai.service.OpenAiService.defaultObjectMapper().writeValueAsString(chunk);
        ResponseBody responseBody = ResponseBody.create(okhttp3.MediaType.get("application/json"), jsonChunk);
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        when(mockCall.execute()).thenReturn(retrofit2.Response.success(responseBody));
        CompletionRequest request = new CompletionRequest();
        doNothing().when(mockExecutorService).shutdown();
        Flowable<CompletionChunk> flow = openAiService.streamCompletion(request);
        List<CompletionChunk> results = new ArrayList<>();
        flow.subscribe(results::add);
        openAiService.shutdownExecutor(); // mid-stream
        assertTrue(results.size() > 0);
    }
    @Test
    @Tag("valid")
    void userFieldIsPropagatedToApi() {
        CompletionRequest request = new CompletionRequest();
        request.setUser("user-123");
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        openAiService.streamCompletion(request);
        ArgumentCaptor<CompletionRequest> captor = ArgumentCaptor.forClass(CompletionRequest.class);
        verify(mockApi, times(1)).createCompletionStream(captor.capture());
        CompletionRequest sentRequest = captor.getValue();
        assertEquals("user-123", sentRequest.getUser());
    }
