    @Test
    @Tag("valid")
    void setStreamFlagOnCompletionRequest() {
        CompletionRequest request = new CompletionRequest();
        request.setStream(false); // before call
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        openAiService.streamCompletion(request);
        assertTrue(Boolean.TRUE.equals(request.getStream()));
        // Note: Changed to getStream for property access, ensure getStream() is available
        // If not available, business logic should provide public Boolean getStream()
    }
    @Test
    @Tag("valid")
    void flowableEmitsCompletionChunks() throws Exception {
        CompletionChunk chunk = new CompletionChunk();
        chunk.setId(UUID.randomUUID().toString());
        chunk.setObject("completion.chunk");
        String jsonChunk = com.theokanning.openai.service.OpenAiService.defaultObjectMapper().writeValueAsString(chunk);
        ResponseBody responseBody = ResponseBody.create(
                okhttp3.MediaType.get("application/json"), jsonChunk + "\n"
        );
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        when(mockCall.execute()).thenReturn(retrofit2.Response.success(responseBody));
        
        CompletionRequest request = new CompletionRequest();
        List<CompletionChunk> received = new ArrayList<>();
        openAiService.streamCompletion(request)
                .blockingForEach(received::add);
        assertFalse(received.isEmpty());
        assertTrue(received.get(0) instanceof CompletionChunk);
        assertNotNull(received.get(0).getId());
        assertEquals("completion.chunk", received.get(0).getObject());
    }
