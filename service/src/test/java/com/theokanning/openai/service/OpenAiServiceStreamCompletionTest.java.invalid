    @Test
    @Tag("integration")
    void flowableSupportsBackpressure() throws Exception {
        // Simulate multiple chunks
        CompletionChunk chunk = new CompletionChunk();
        chunk.setId("chunk1");
        chunk.setObject("completion.chunk");
        CompletionChunk chunk2 = new CompletionChunk();
        chunk2.setId("chunk2");
        chunk2.setObject("completion.chunk");
        
        String jsonChunk1 = com.theokanning.openai.service.OpenAiService.defaultObjectMapper().writeValueAsString(chunk);
        String jsonChunk2 = com.theokanning.openai.service.OpenAiService.defaultObjectMapper().writeValueAsString(chunk2);
        ResponseBody responseBody = ResponseBody.create(
                okhttp3.MediaType.get("application/json"),
                jsonChunk1 + "\n" + jsonChunk2 + "\n"
        );
        when(mockApi.createCompletionStream(any(CompletionRequest.class))).thenReturn(mockCall);
        when(mockCall.execute()).thenReturn(retrofit2.Response.success(responseBody));
        CompletionRequest request = new CompletionRequest();
        
        AtomicInteger count = new AtomicInteger(0);
        // .limit(1) is not a valid rxjava Flowable method,
        // Instead subscribe and break after first
        openAiService.streamCompletion(request)
                .take(1)
                .blockingForEach(c -> {
                    count.incrementAndGet();
                    assertNotNull(c.getId());
                });
        assertEquals(1, count.get());
    }
