    void testCreateImageVariationWithValidRequestAndExistingFile() throws IOException {
        String validImagePath = "src/test/resources/valid-image.png";
        CreateImageVariationRequest request = new CreateImageVariationRequest("512x512", "url", 2, null);
        ImageResult expectedResult = new ImageResult();
        List<ImageResult.ImageData> dataList = new ArrayList<>();
        dataList.add(new ImageResult.ImageData("http://example.com/image1.png"));
        expectedResult.setData(dataList);
        when(apiMock.createImageVariation(any())).thenReturn(Single.just(expectedResult));
        ImageResult actualResult = service.createImageVariation(request, validImagePath);
        assertNotNull((ImageResult) actualResult);
        assertNotNull((List<?>) actualResult.getData());
        assertEquals(1, ((List<?>) actualResult.getData()).size());
        assertTrue(((ImageResult.ImageData) ((List<?>) actualResult.getData()).get(0)).getUrl().startsWith("http"));
    }
