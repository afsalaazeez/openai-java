            if (lock != null) lock.release();
        } catch(IOException e) {
            // Expected exception
        } finally {
            if (lockedFile != null) lockedFile.close();
        }
    }
    @Test
    @Tag("integration")
    void testCreateImageVariationConcurrentInvocations() throws Exception {
        String validImagePath = "src/test/resources/valid-image.png";
        CreateImageVariationRequest request = new CreateImageVariationRequest("512x512", "url", 1, null);
        ImageResult expectedResult = new ImageResult();
        List<ImageResult.ImageData> dataList = new ArrayList<>();
        dataList.add(new ImageResult.ImageData("http://example.com/image-threaded.png"));
        expectedResult.setData(dataList);
        when(apiMock.createImageVariation(any())).thenReturn(Single.just(expectedResult));
        int threadCount = 5;
        ExecutorService executor = Executors.newFixedThreadPool(threadCount);
        List<Future<ImageResult>> results = new ArrayList<>();
        for (int i = 0; i < threadCount; i++) {
            results.add(executor.submit(() -> service.createImageVariation(request, validImagePath)));
        }
        for (Future<ImageResult> fut : results) {
            ImageResult res = fut.get();
            assertNotNull((ImageResult) res);
            assertEquals(1, ((List<?>) res.getData()).size());
        }
        executor.shutdown();
    }
    @Test
    @Tag("invalid")
    void testCreateImageVariationHandlesPartialApiResponse() {
        String validImagePath = "src/test/resources/valid-image.png";
        CreateImageVariationRequest request = new CreateImageVariationRequest("512x512", "url", 3, null);
        ImageResult partialResult = new ImageResult();
        partialResult.setData(Collections.emptyList());
        when(apiMock.createImageVariation(any())).thenReturn(Single.just(partialResult));
        ImageResult result = service.createImageVariation(request, validImagePath);
        assertNotNull((ImageResult) result);
        assertEquals(0, ((List<?>) result.getData()).size());
    }
}