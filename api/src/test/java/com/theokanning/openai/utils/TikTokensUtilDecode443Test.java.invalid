    @Test
    @Tag("valid")
    public void testDecodeReturnsDecodedStringForValidEncodingTypeAndEncodedList() {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        Encoding encoding = registry.getEncoding(encodingType);
        String original = "hello world";
        List<Integer> encoded = encoding.encode(original);
        String decoded = TikTokensUtil.decode(encodingType, encoded);
        Assertions.assertEquals((String) original, (String) decoded, "Decoded string should match original");
    }
