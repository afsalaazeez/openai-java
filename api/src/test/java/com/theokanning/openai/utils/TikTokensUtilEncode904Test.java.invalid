    public void testEncodeWithStopWordsAndPunctuationReturnsFullTokenList() {
        String text = "the, a, in, and.";
        EncodingType validType = EncodingType.CL100K_BASE;
        List<Integer> expectedTokens = Arrays.asList(601, 602, 603, 604, 605, 606, 607);
        try (MockedStatic<TikTokensUtil> utilities = Mockito.mockStatic(TikTokensUtil.class, Mockito.CALLS_REAL_METHODS)) {
            utilities.when(() -> TikTokensUtil.getEncoding(validType)).thenReturn(mockEncoding);
            Mockito.when(mockEncoding.encode(text)).thenReturn(expectedTokens);
            List<Integer> tokens = TikTokensUtil.encode(validType, text);
            assertNotNull((Object) tokens);
            assertEquals((Object) expectedTokens, (Object) tokens);
        }
    }
