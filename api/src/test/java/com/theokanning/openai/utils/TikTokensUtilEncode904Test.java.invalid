    @Test
    @Tag("integration")
    public void testEncodeWithRepeatedEmptyStringCallsReturnsEmptyListEveryTime() {
        String text = "";
        EncodingType validType = EncodingType.CL100K_BASE;
        for (int i = 0; i < 5; i++) {
            List<Integer> tokens = TikTokensUtil.encode(validType, text);
            assertNotNull((Object) tokens);
            assertTrue(((List<?>) tokens).isEmpty(), "Each call with empty string should return empty list.");
        }
    }
    @Test
    @Tag("invalid")
    public void testEncodeWithRegistryReturningNullEncodingHandlesGracefully() {
        EncodingType validType = EncodingType.CL100K_BASE;
        String text = "some valid text";
        // Business logic doesn't handle null Encoding returned from registry - throws NullPointerException. 
        // Suggestion: TikTokensUtil.encode should check for null Encoding and throw a more descriptive exception.
        try (MockedStatic<TikTokensUtil> utilities = Mockito.mockStatic(TikTokensUtil.class, Mockito.CALLS_REAL_METHODS)) {
            utilities.when(() -> TikTokensUtil.getEncoding(validType)).thenReturn(null);
            assertThrows(NullPointerException.class, () -> TikTokensUtil.encode(validType, text));
        }
    }
    @Test
    @Tag("boundary")
    public void testEncodeWithVariousUnicodeSpaceCharactersReturnsEmptyList() {
        String text = "\u00A0\u2000\u3000";
        EncodingType validType = EncodingType.CL100K_BASE;
        List<Integer> tokens = TikTokensUtil.encode(validType, text);
        assertTrue(((List<?>) tokens).isEmpty(), "Should return empty token list for unicode spaces.");
    }
}