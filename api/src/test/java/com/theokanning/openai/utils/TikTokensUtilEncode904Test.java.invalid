    @Test
    @Tag("valid")
    public void testEncodeWithValidEncodingTypeAndNonEmptyText() {
        String text = "This is a test.";
        EncodingType validType = EncodingType.CL100K_BASE;
        List<Integer> expectedTokens = Arrays.asList(1, 2, 3, 4);
        try (MockedStatic<TikTokensUtil> utilities = Mockito.mockStatic(TikTokensUtil.class, Mockito.CALLS_REAL_METHODS)) {
            utilities.when(() -> TikTokensUtil.getEncoding(validType)).thenReturn(mockEncoding);
            Mockito.when(mockEncoding.encode(text)).thenReturn(expectedTokens);
            List<Integer> actualTokens = TikTokensUtil.encode(validType, text);
            assertNotNull((Object) actualTokens, "Returned token list should not be null.");
            assertEquals((Object) expectedTokens, (Object) actualTokens, "Returned tokens should match the expected tokens.");
            assertFalse(((List<?>) actualTokens).isEmpty(), "Returned token list should not be empty.");
        }
    }
