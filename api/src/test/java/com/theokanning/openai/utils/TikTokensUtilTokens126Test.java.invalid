package com.theokanning.openai.utils;
import com.knuddels.jtokkit.Encodings;
import com.knuddels.jtokkit.api.Encoding;
import com.knuddels.jtokkit.api.EncodingRegistry;
import com.knuddels.jtokkit.api.EncodingType;
import com.knuddels.jtokkit.api.ModelType;
import com.theokanning.openai.completion.chat.ChatMessage;
import org.junit.jupiter.api.*;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import java.util.*;
import java.util.concurrent.*;
import java.util.stream.Collectors;
import static org.assertj.core.api.Assertions.assertThat;
import static org.junit.jupiter.api.Assertions.*;
import lombok.AllArgsConstructor;
import lombok.Getter;

class TikTokensUtilTokens126Test {
    private final EncodingRegistry registry = Encodings.newDefaultEncodingRegistry();
    private final EncodingType validEncodingType = EncodingType.CL100K_BASE;
    private final Encoding validEncoding = registry.getEncoding(validEncodingType);
    @Test
    @Tag("valid")
    void testTokensReturnsCorrectTokenCountForStandardText() {
        String text = "Hello, world!";
        int expectedTokens = validEncoding.encode(text).size();
        int actualTokens = TikTokensUtil.tokens(validEncodingType, text);
        assertEquals((int) expectedTokens, (int) actualTokens);
    }
    @Test
    @Tag("boundary")
    void testTokensReturnsZeroForEmptyString() {
        String text = "";
        int actualTokens = TikTokensUtil.tokens(validEncodingType, text);
        assertEquals(0, (int) actualTokens);
    }
    @Test
    @Tag("boundary")
    void testTokensReturnsZeroForNullString() {
        String text = null;
        int actualTokens = TikTokensUtil.tokens(validEncodingType, text);
        assertEquals(0, (int) actualTokens);
    }
    @Test
    @Tag("boundary")
    void testTokensReturnsZeroForWhitespaceString() {
        String whitespace1 = "   ";
        String whitespace2 = "\t\t";
        assertEquals(0, (int) TikTokensUtil.tokens(validEncodingType, whitespace1));
        assertEquals(0, (int) TikTokensUtil.tokens(validEncodingType, whitespace2));
    }
    @Test
    @Tag("valid")
    void testTokensHandlesLargeTextInput() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 10_000; i++) {
            sb.append('a');
        }
        String largeText = sb.toString();
        int expectedTokens = validEncoding.encode(largeText).size();
        int actualTokens = TikTokensUtil.tokens(validEncodingType, largeText);
        assertEquals((int) expectedTokens, (int) actualTokens);
    }
    @Test
    @Tag("valid")
    void testTokensCorrectlyCountsUnicodeAndSpecialCharacters() {
        String unicodeText = "naïve café 😀 привет мир 🦄";
        int expectedTokens = validEncoding.encode(unicodeText).size();
        int actualTokens = TikTokensUtil.tokens(validEncodingType, unicodeText);
        assertEquals((int) expectedTokens, (int) actualTokens);
    }
    @Test
    @Tag("integration")
    void testTokensWorksWithAllEncodingTypes() {
        String text = "test";
        for (EncodingType type : EncodingType.values()) {
            Encoding encodingForType = registry.getEncoding(type);
            int expectedTokens = encodingForType.encode(text).size();
            int actualTokens = TikTokensUtil.tokens(type, text);
            assertEquals((int) expectedTokens, (int) actualTokens, "EncodingType: " + type);
        }
    }
    @Test
    @Tag("invalid")
    void testTokensThrowsOrReturnsForUnsupportedEncodingType() {
        EncodingType unsupportedType = null; // Simulate missing/unknown encoding type
        int actualTokens = TikTokensUtil.tokens(unsupportedType, "Some text");
        assertEquals(0, (int) actualTokens);
    }
    @Test
    @Tag("valid")
    void testTokensIsDeterministicForSameInputs() {
        String text = "repeatable input";
        int first = TikTokensUtil.tokens(validEncodingType, text);
        int second = TikTokensUtil.tokens(validEncodingType, text);
        assertEquals((int) first, (int) second);
    }
    @Test
    @Tag("boundary")
    void testTokensIgnoresLeadingAndTrailingWhitespaceOnlyIfConsistentWithEncoder() {
        String base = "hello";
        String padded = "   hello  ";
        int expectedBaseTokens = validEncoding.encode(base).size();
        int expectedPaddedTokens = validEncoding.encode(padded).size();
        int actualBaseTokens = TikTokensUtil.tokens(validEncodingType, base);
        int actualPaddedTokens = TikTokensUtil.tokens(validEncodingType, padded);
        assertEquals((int) expectedBaseTokens, (int) actualBaseTokens);
        assertEquals((int) expectedPaddedTokens, (int) actualPaddedTokens);
    }
    @Test
    @Tag("boundary")
    void testTokensReturnsZeroForControlCharactersOnly() {
        String controlString = "\u0000\u0001\u0002";
        assertEquals(0, (int) TikTokensUtil.tokens(validEncodingType, controlString));
    }
    @Test
    @Tag("integration")
    void testTokensThreadSafeDuringConcurrentInvocation() throws Exception {
        final int numThreads = 10;
        final int numCalls = 100;
        String text = "concurrent test";
        ExecutorService pool = Executors.newFixedThreadPool(numThreads);
        List<Callable<Integer>> tasks = new ArrayList<>();
        for (int i = 0; i < numCalls; i++) {
            tasks.add(() -> TikTokensUtil.tokens(validEncodingType, text));
        }
        List<Integer> results = pool.invokeAll(tasks).stream()
                .map(future -> {
                    try { return future.get(); }
                    catch (Exception e) { fail("Exception in thread execution"); return -1; }
                })
                .collect(Collectors.toList());
        pool.shutdown();
        int expectedTokens = TikTokensUtil.tokens(validEncodingType, text);
        for (Integer out : results) {
            assertEquals((int) expectedTokens, (int) out);
        }
    }
    @Test
    @Tag("valid")
    void testTokensTreatsTextAsTextEvenIfItLooksLikeAModelName() {
        String text = "gpt-4"; // This is just text, not used as modelName
        int expectedTokens = validEncoding.encode(text).size();
        int actualTokens = TikTokensUtil.tokens(validEncodingType, text);
        assertEquals((int) expectedTokens, (int) actualTokens);
    }
    @Test
    @Tag("boundary")
    void testTokensPerformsUnderExtremelyLargeInput() {
        String massiveText = "X".repeat(1_000_000); // 1 million chars
        int expectedTokens = validEncoding.encode(massiveText).size();
        int actualTokens = TikTokensUtil.tokens(validEncodingType, massiveText);
        assertEquals((int) expectedTokens, (int) actualTokens);
    }
    @Test
    @Tag("integration")
    void testTokensUsesEncodingFromRegistry() {
        EncodingType knownType = EncodingType.CL100K_BASE; // TODO: Use a specific supported EncodingType if needed
        String text = "sample";
        Encoding encoding = registry.getEncoding(knownType);
        int expectedTokens = encoding.encode(text).size();
        int actualTokens = TikTokensUtil.tokens(knownType, text);
        assertEquals((int) expectedTokens, (int) actualTokens);
    }
}