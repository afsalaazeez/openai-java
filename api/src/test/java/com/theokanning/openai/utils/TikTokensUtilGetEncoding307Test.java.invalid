    @Test
    @Tag("integration")
    public void testGetEncodingSupportsConcurrentAccess() throws InterruptedException {
        getModelMap().put(VALID_MODEL_NAME, dummyEncoding1);
        getModelMap().put(VALID_CANONICAL_NAME, dummyEncoding2);
        List<String> modelNames = Arrays.asList(VALID_MODEL_NAME, VALID_CANONICAL_NAME, INVALID_MODEL_NAME, null, SPECIAL_CHAR_MODEL_NAME);
        List<Encoding> results = Collections.synchronizedList(new ArrayList<>());
        int threadCount = modelNames.size();
        Thread[] threads = new Thread[threadCount];
        for (int i = 0; i < threadCount; i++) {
            final int idx = i;
            threads[i] = new Thread(() -> {
                Encoding enc = TikTokensUtil.getEncoding(modelNames.get(idx));
                results.add(enc);
            });
        }
        for (Thread t : threads) t.start();
        for (Thread t : threads) t.join();
        for (int i = 0; i < threadCount; i++) {
            String name = modelNames.get(i);
            if (name == VALID_MODEL_NAME) {
                assertEquals((Object)dummyEncoding1, (Object)results.get(i));
            } else if (name == VALID_CANONICAL_NAME) {
                assertEquals((Object)dummyEncoding2, (Object)results.get(i));
            } else {
                assertNull((Object)results.get(i));
            }
        }
    }
