public class TikTokensUtilGetModelTypeByNameTest {
    @Test
    @Tag("valid")
    public void testGpt35Turbo0301ReturnsCorrectModelType() {
        String modelName = ModelEnum.GPT_3_5_TURBO_0301.getName();
        ModelType result = TikTokensUtil.getModelTypeByName(modelName);
        assertEquals((ModelType) ModelType.GPT_3_5_TURBO, (ModelType) result);
    }
    @Test
    @Tag("valid")
    public void testGpt4ReturnsModelTypeGpt4() {
        String modelName = ModelEnum.GPT_4.getName();
        ModelType result = TikTokensUtil.getModelTypeByName(modelName);
        assertEquals((ModelType) ModelType.GPT_4, (ModelType) result);
    }
    @Test
    @Tag("valid")
    public void testGpt4AliasesReturnModelTypeGpt4() {
        String[] aliases = {
                ModelEnum.GPT_4_32K.getName(),
                ModelEnum.GPT_4_32K_0314.getName(),
                ModelEnum.GPT_4_0314.getName(),
        };
        for (String alias : aliases) {
            ModelType result = TikTokensUtil.getModelTypeByName(alias);
            assertEquals((ModelType) ModelType.GPT_4, (ModelType) result, "Alias: " + alias);
        }
    }
    @Test
    @Tag("valid")
    public void testDirectModelTypeNameReturnsCorrespondingModelType() {
        for (ModelType modelType : ModelType.values()) {
            String name = modelType.getName();
            // Skip names that should be mapped by shortcut logic for this scenario
            if (
                name.equals(ModelEnum.GPT_3_5_TURBO_0301.getName()) ||
                name.equals(ModelEnum.GPT_4.getName()) ||
                name.equals(ModelEnum.GPT_4_32K.getName()) ||
                name.equals(ModelEnum.GPT_4_32K_0314.getName()) ||
                name.equals(ModelEnum.GPT_4_0314.getName())
            ) {
                continue;
            }
            ModelType result = TikTokensUtil.getModelTypeByName(name);
            assertEquals((ModelType) modelType, (ModelType) result, "Model type: " + name);
        }
    }
