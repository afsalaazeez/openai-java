public class TikTokensUtilGetModelTypeByNameTest {
    @Test
    @Tag("valid")
    public void testReturnsGpt3_5TurboForGpt3_5Turbo0301Name() {
        String input = ModelEnum.GPT_3_5_TURBO_0301.getName();
        ModelType result = TikTokensUtil.getModelTypeByName(input);
        assertEquals((ModelType) ModelType.GPT_3_5_TURBO, (ModelType) result);
    }
    @Test
    @Tag("valid")
    public void testReturnsGpt4ForGpt4Name() {
        String input = ModelEnum.GPT_4.getName();
        ModelType result = TikTokensUtil.getModelTypeByName(input);
        assertEquals((ModelType) ModelType.GPT_4, (ModelType) result);
    }
