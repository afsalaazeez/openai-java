    @Test
    @Tag("integration")
    public void testDirectModelTypeEnumNameInputReturnsExpectedType() {
        for (ModelType modelType : ModelType.values()) {
            String name = modelType.getName();
            ModelType result = TikTokensUtil.getModelTypeByName(name);
            if (
                name.equals(ModelEnum.GPT_3_5_TURBO_0301.getName())
            ) {
                assertEquals((ModelType) ModelType.GPT_3_5_TURBO, (ModelType) result, "Enum name: " + name);
            } else if (
                name.equals(ModelEnum.GPT_4.getName()) ||
                name.equals(ModelEnum.GPT_4_32K.getName()) ||
                name.equals(ModelEnum.GPT_4_32K_0314.getName()) ||
                name.equals(ModelEnum.GPT_4_0314.getName())
            ) {
                assertEquals((ModelType) ModelType.GPT_4, (ModelType) result, "Enum name: " + name);
            } else {
                assertEquals((ModelType) modelType, (ModelType) result, "Enum name: " + name);
            }
        }
    }
