        String emptyInput = "";
        String whitespaceInput = "   ";
        ModelType resultEmpty = TikTokensUtil.getModelTypeByName(emptyInput);
        ModelType resultWhitespace = TikTokensUtil.getModelTypeByName(whitespaceInput);
