import lombok.AllArgsConstructor;
import lombok.Getter;
import java.util.*;

class TikTokensUtilGetModelTypeByNameTest {
    @Test
    @Tag("valid")
    void modelTypeByNameForGpt35Turbo0301() {
        ModelType result = TikTokensUtil.getModelTypeByName("gpt-3.5-turbo-0301");
        assertEquals(ModelType.GPT_3_5_TURBO, result);
    }
    @Test
    @Tag("valid")
    void modelTypeByNameForGpt4() {
        ModelType result = TikTokensUtil.getModelTypeByName("gpt-4");
        assertEquals(ModelType.GPT_4, result);
    }
    @Test
    @Tag("valid")
    void modelTypeByNameForGpt432k() {
        ModelType result = TikTokensUtil.getModelTypeByName("gpt-4-32k");
        assertEquals(ModelType.GPT_4, result);
