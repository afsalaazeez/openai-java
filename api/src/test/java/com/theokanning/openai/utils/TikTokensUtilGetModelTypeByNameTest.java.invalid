    @Test
    @Tag("valid")
    void modelTypeByNameReturnsDifferentTypesForDifferentFamilies() {
        ModelType gpt35Result = TikTokensUtil.getModelTypeByName("gpt-3.5-turbo-0301");
        ModelType gpt4Result = TikTokensUtil.getModelTypeByName("gpt-4");
        
        assertEquals(ModelType.GPT_3_5_TURBO, gpt35Result);
        assertEquals(ModelType.GPT_4, gpt4Result);
