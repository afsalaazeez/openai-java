package com.theokanning.openai.utils;
import com.knuddels.jtokkit.api.ModelType;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import com.theokanning.openai.utils.TikTokensUtil;
import org.junit.jupiter.api.*;
import com.knuddels.jtokkit.Encodings;
import com.knuddels.jtokkit.api.Encoding;
import com.knuddels.jtokkit.api.EncodingRegistry;
import com.knuddels.jtokkit.api.EncodingType;
import com.theokanning.openai.completion.chat.ChatMessage;
import lombok.AllArgsConstructor;
import lombok.Getter;
import java.util.*;

public class TikTokensUtilGetModelTypeByNameTest {
    @Test
    @Tag("valid")
    public void testValidTurbo0301NameReturnsTurboModelType() {
        String modelName = "gpt-3.5-turbo-0301";
        ModelType expectedModelType = ModelType.GPT_3_5_TURBO;
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertEquals(expectedModelType, actualModelType);
    }
    @Test
    @Tag("valid")
    public void testValidGpt4NameReturnsGpt4ModelType() {
        String modelName = "gpt-4";
        ModelType expectedModelType = ModelType.GPT_4;
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertEquals(expectedModelType, actualModelType);
    }
    @Test
    @Tag("valid")
    public void testValidGpt4AlternateNamesReturnGpt4ModelType() {
        String[] alternateNames = { "gpt-4-32k", "gpt-4-32k-0314", "gpt-4-0314" };
        ModelType expectedModelType = ModelType.GPT_4;
        for (String modelName : alternateNames) {
            ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
            assertEquals(expectedModelType, actualModelType);
        }
    }
    @Test
    @Tag("valid")
    public void testValidStandardModelNameReturnsMatchingModelType() {
        for (ModelType expectedModelType : ModelType.values()) {
            String modelName = expectedModelType.getName();
            ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
            assertEquals(expectedModelType, actualModelType);
        }
    }
    
    @Test
    @Tag("invalid")
    public void testUnknownModelNameReturnsNull() {
        String unknownModelName = "non-existent-model";
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(unknownModelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("boundary")
    public void testNullModelNameInputReturnsNull() {
        String modelName = null;
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("boundary")
    public void testEmptyModelNameInputReturnsNull() {
        String modelName = "";
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("boundary")
    public void testWhitespaceModelNameInputReturnsNull() {
        String modelName = "   ";
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("invalid")
    public void testModelEnumNameNotInModelTypeReturnsNull() {
        String modelName = "gpt-4-1106-preview"; // TODO make sure this is not in ModelType.values()
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("invalid")
    public void testCaseVariantModelNameReturnsNull() {
        String modelName = "GPT-4"; // case variant
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("invalid")
    public void testValidModelNameWithWhitespaceReturnsNull() {
        String modelName = " gpt-4 "; // leading/trailing whitespace
        ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
        assertNull(actualModelType);
    }
    @Test
    @Tag("integration")
    public void testAllModelTypeNamesResolvesCorrectly() {
        for (ModelType expectedModelType : ModelType.values()) {
            String modelName = expectedModelType.getName();
            ModelType actualModelType = (ModelType) TikTokensUtil.getModelTypeByName(modelName);
            assertEquals(expectedModelType, actualModelType);
        }
    }
}