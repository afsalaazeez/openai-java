    public void testTokensReturnsZeroForWhitespaceString() {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        String[] whitespaceTests = { "   ", "\t\t", "    \r\n  ", "\n" };
        for (String text : whitespaceTests) {
            int actualTokenCount = TikTokensUtil.tokens(encodingType, text);
            assertEquals(0, (int)actualTokenCount,
                    "Expected zero tokens for input: [" + text + "]");
        }
    }
