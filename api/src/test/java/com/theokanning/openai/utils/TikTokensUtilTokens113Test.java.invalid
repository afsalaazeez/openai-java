    @Test
    @Tag("integration")
    @DisplayName("Thread-safety during concurrent invocation")
    public void testTokensThreadSafeDuringConcurrentInvocation() throws InterruptedException, ExecutionException {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        String text = "Thread safe input.";
        Encoding enc = registry.getEncoding(encodingType);
        int expected = enc.encode(text).size();
        int threads = 20;
        ExecutorService executorService = Executors.newFixedThreadPool(threads);
        List<Callable<Integer>> tasks = new ArrayList<>();
        for (int i = 0; i < threads; i++) {
            tasks.add(() -> TikTokensUtil.tokens(encodingType, text));
        }
        List<Future<Integer>> results = executorService.invokeAll(tasks);
        for (Future<Integer> future : results) {
            assertEquals((int)expected, (int)future.get());
        }
        executorService.shutdown();
    }
