    @Test
    @Tag("integration")
    @DisplayName("Performs under extremely large input")
    public void testTokensPerformsUnderExtremelyLargeInput() {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        StringBuilder sb = new StringBuilder();
        int chars = 1_000_000; // 1 million
        for (int i = 0; i < chars; i++) {
            sb.append('b');
        }
        String massiveText = sb.toString();
        Encoding enc = registry.getEncoding(encodingType);
        List<Integer> expectedTokens = enc.encode(massiveText);
        long start = System.currentTimeMillis();
        int actualTokenCount = TikTokensUtil.tokens(encodingType, massiveText);
        long duration = System.currentTimeMillis() - start;
        assertEquals((int)expectedTokens.size(), (int)actualTokenCount);
        assertTrue(duration < 5000, "Execution took too long: " + duration + "ms");
    }
