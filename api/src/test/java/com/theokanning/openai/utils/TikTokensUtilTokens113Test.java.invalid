    public void testTokensHandlesLargeTextInput() {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        StringBuilder sb = new StringBuilder();
        int chars = 10000;
        for (int i = 0; i < chars; i++) {
            sb.append('a');
        }
        String largeText = sb.toString();
        Encoding enc = registry.getEncoding(encodingType);
        List<Integer> expectedTokens = enc.encode(largeText);
        int actualTokenCount = TikTokensUtil.tokens(encodingType, largeText);
