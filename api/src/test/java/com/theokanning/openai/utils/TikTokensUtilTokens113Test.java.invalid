    public void testTokensIgnoresLeadingAndTrailingWhitespaceOnlyIfConsistentWithEncoder() {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        String textNoWhitespace = "hello";
        String textWithWhitespace = "   hello   ";
        Encoding enc = registry.getEncoding(encodingType);
        int expectedNoWhitespace = enc.encode(textNoWhitespace).size();
        int expectedWithWhitespace = enc.encode(textWithWhitespace).size();
        int actualNoWhitespace = TikTokensUtil.tokens(encodingType, textNoWhitespace);
        int actualWithWhitespace = TikTokensUtil.tokens(encodingType, textWithWhitespace);
