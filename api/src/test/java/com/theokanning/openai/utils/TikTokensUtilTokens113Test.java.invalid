    private static final EncodingRegistry registry = Encodings.newDefaultEncodingRegistry();
    @Test
    @Tag("valid")
    @DisplayName("Token Counting for Typical Text Input")
    public void testTokensReturnsCorrectTokenCountForStandardText() {
        EncodingType encodingType = EncodingType.CL100K_BASE;
        String text = "Hello, world!";
        Encoding enc = registry.getEncoding(encodingType);
        List<Integer> expectedTokens = enc.encode(text);
        int actualTokenCount = TikTokensUtil.tokens(encodingType, text);
        assertEquals((int)expectedTokens.size(), (int)actualTokenCount);
    }
