public class TikTokensUtilGetEncodingTest {
    private final EncodingRegistry registry = Encodings.newDefaultEncodingRegistry();
    
    @Test
    @Tag("valid")
    public void testValidEncodingTypeReturnsCorrectEncoding() {
        EncodingType validEncodingType = EncodingType.values()[0]; // Use an existing EncodingType
        Encoding expectedEncoding = registry.getEncoding(validEncodingType);
        Encoding actualEncoding = (Encoding) TikTokensUtil.getEncoding(validEncodingType);
        Assertions.assertNotNull((Object) actualEncoding, "Encoding should not be null for valid EncodingType");
        Assertions.assertEquals((Object) expectedEncoding, (Object) actualEncoding,
                "getEncoding should return the encoding from the registry for valid EncodingType");
    }
