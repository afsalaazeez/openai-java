    @Test
    @Tag("boundary")
    public void testReturnedEncodingIsConsistentWithRegistry() {
        EncodingType encodingType = EncodingType.values()[0];
        Encoding expectedEncoding = registry.getEncoding(encodingType);
        Encoding actualEncoding = (Encoding) TikTokensUtil.getEncoding(encodingType);
        Assertions.assertSame((Object) expectedEncoding, (Object) actualEncoding,
                "getEncoding must return the same instance as the registry for the same EncodingType");
    }
    @Test
    @Tag("boundary")
    public void testMultipleEncodingTypeCallsReturnConsistentResults() {
        EncodingType encodingType = EncodingType.values()[0];
