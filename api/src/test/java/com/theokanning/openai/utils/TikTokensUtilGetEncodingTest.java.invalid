        }
    }
    @Test
    @Tag("integration")
    public void testEncodingReturnedCanEncodeAndDecode() {
        EncodingType encodingType = EncodingType.values()[0];
        String testString = "hello world";
        Encoding encoding = (Encoding) TikTokensUtil.getEncoding(encodingType);
        Assertions.assertNotNull((Object) encoding, "Encoding should not be null");
        java.util.List<Integer> encodedList = encoding.encode(testString);
        Assertions.assertNotNull((Object) encodedList, "Encoded list should not be null");
        Assertions.assertFalse(((java.util.List<?>) encodedList).isEmpty(), "Encoded list should not be empty for non-empty string");
        String decodedString = encoding.decode(encodedList);
        Assertions.assertEquals((Object) testString, (Object) decodedString,
                "Decoding must retrieve original input string after encoding");
    }
