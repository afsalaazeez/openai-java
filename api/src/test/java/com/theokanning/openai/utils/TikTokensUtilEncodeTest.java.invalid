        List<Integer> expectedTokens = Arrays.asList(1, 2, 3, 4, 5); // TODO: set expected mock tokens
        when(mockEncoding.encode(testText)).thenReturn(expectedTokens);
        List<Integer> actualTokens = TikTokensUtil.encode(mockEncoding, testText);
        assertThat((List<Integer>) actualTokens).isEqualTo((List<Integer>) expectedTokens);
    }
