        String inputText = "hello world";
        List<Integer> expectedOutput = Arrays.asList(1, 2, 3, 4);
        Mockito.when(encodingMock.encode(inputText)).thenReturn(expectedOutput);
        // Act
        List<Integer> actualOutput = TikTokensUtil.encode(encodingMock, inputText);
        // Assert
        assertEquals((Object) expectedOutput, (Object) actualOutput, "Encoding should delegate to Encoding.encode for normal ASCII input");
    }
